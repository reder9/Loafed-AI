# Google Gemini API Keys (multi-account fallback supported)
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=


# Default Model: gemini-3.8-flash (recommended) or gemini-3.5-flash-lite
DEFAULT_MODEL=gemini-3.8-flash

# Port for the server
PORT=8000

# Logging: INFO records warnings/errors and important state changes; use DEBUG
# temporarily when investigating request-level behavior.
LOG_LEVEL=INFO

# Required, distinct secrets (generate a unique random value for each setting).
# Never reuse the example, a default, or the same value for both settings.
SIGNATURE_SECRET=
ADMIN_SECRET=

# Leave false unless a trusted reverse proxy appends the real client IP to
# X-Forwarded-For. API Gateway source IP is read from the ASGI client by default.
TRUST_PROXY_HEADERS=false
