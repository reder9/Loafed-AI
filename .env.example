# Google Gemini API Keys (multi-account fallback supported)
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=


# Default Model: gemini-3.8-flash (recommended) or gemini-3.5-flash-lite
DEFAULT_MODEL=gemini-3.8-flash

# Port for the server
PORT=8000

# Logging: INFO records warnings/errors and important state changes; use DEBUG
# temporarily when investigating request-level behavior.
LOG_LEVEL=INFO
